<?xml version="1.0" encoding="utf-8"?>
<!-- Default circular art for turntable widget preview with Nest Music Sunset Theme -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Circular sunset gradient background -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="#8B5CF6"
                android:centerColor="#FF6E40"
                android:endColor="#1E1B4B"
                android:type="linear" />
        </shape>
    </item>
    <!-- Centered Nest Music icon -->
    <item
        android:drawable="@drawable/ic_launcher_foreground"
        android:gravity="center" />
</layer-list>
