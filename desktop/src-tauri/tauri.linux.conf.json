{
  "bundle": {
    "targets": ["appimage", "deb"],
    "category": "Music",
    "license": "AGPL-3.0",
    "licenseFile": "../LICENSE",
    "homepage": "https://github.com/Davidix07TV/Nest-Music",
    "shortDescription": "Unofficial YouTube Music desktop player",
    "longDescription": "Nest Music is an unofficial desktop client for YouTube Music: streaming, synced lyrics, offline downloads, crossfade, visualizer, Discord Rich Presence, Last.fm scrobbling and an OBS overlay.",
    "resources": {
      "resources/node": "node"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "section": "sound",
        "priority": "optional",
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0 | libgtk-3-0t64",
          "libayatana-appindicator3-1",
          "libasound2 | libasound2t64",
          "libdbus-1-3"
        ]
      }
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nest Music",
        "width": 1100,
        "height": 700,
        "minWidth": 1040,
        "minHeight": 560,
        "fullscreen": false,
        "resizable": true,
        "decorations": true
      }
    ]
  }
}
